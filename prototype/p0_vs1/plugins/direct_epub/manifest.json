{
  "manifest_version": "1.0.0",
  "plugin": {
    "plugin_id": "org.raiatea.vs1.direct-epub-extractor",
    "name": "Raiatea VS1 Direct EPUB Extractor",
    "version": "0.1.0"
  },
  "raiatea_plugin_api": {
    "min_inclusive": "1.0.0",
    "max_exclusive": "2.0.0"
  },
  "families": ["extractor"],
  "capabilities": [
    {
      "capability_id": "extract.run",
      "profiles": [
        {
          "profile_id": "epub-direct-stdlib",
          "family": "extractor",
          "input_classes": ["application/epub+zip"],
          "output_classes": [
            "vs1d-direct-epub-provider-observation"
          ],
          "contracts": [
            {
              "contract_id": "raiatea.extraction.processing-run",
              "version_range": {
                "min_inclusive": "0.1.0",
                "max_exclusive": "0.2.0"
              }
            }
          ],
          "backend": "python-stdlib",
          "mode": "package-semantic"
        }
      ]
    }
  ],
  "permissions": {
    "network": [],
    "filesystem": [],
    "secrets": [],
    "temporary_workspace": true,
    "resource_hints": {
      "cpu_cores": 1,
      "memory_mb": 256,
      "timeout_seconds": 30
    }
  },
  "entrypoint": {
    "kind": "process",
    "command": ["python", "-m", "prototype.p0_vs1.plugins.direct_epub.plugin"]
  },
  "trust_tier": "official",
  "provenance": {
    "publisher": "Raiatea"
  }
}
