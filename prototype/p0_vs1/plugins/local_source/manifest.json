{
  "manifest_version": "1.0.0",
  "plugin": {
    "plugin_id": "org.raiatea.vs1.local-source",
    "name": "Raiatea VS1 Local Catalog Source",
    "version": "0.1.0"
  },
  "raiatea_plugin_api": {
    "min_inclusive": "1.0.0",
    "max_exclusive": "2.0.0"
  },
  "families": ["source"],
  "capabilities": [
    {
      "capability_id": "source.discover",
      "profiles": [
        {
          "profile_id": "local-catalog-read-only",
          "family": "source",
          "input_classes": ["vs1c-discovery-snapshot"],
          "output_classes": ["vs1c-source-reference-bundle"],
          "contracts": [],
          "mode": "catalog-snapshot-to-references"
        }
      ]
    }
  ],
  "permissions": {
    "network": [],
    "filesystem": [],
    "secrets": [],
    "temporary_workspace": true,
    "resource_hints": {
      "cpu_cores": 1,
      "memory_mb": 128,
      "timeout_seconds": 30
    }
  },
  "entrypoint": {
    "kind": "process",
    "command": ["python", "-m", "prototype.p0_vs1.plugins.local_source.plugin"]
  },
  "trust_tier": "official",
  "provenance": {
    "publisher": "Raiatea"
  }
}
