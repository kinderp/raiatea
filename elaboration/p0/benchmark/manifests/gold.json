      "coordinate_semantics": {"kind": "epub-package-logical", "canonical_rendered_pages": false}
    },
    "B02-EPUB-NEG-002": {
      "assertion_modes": ["exact"],
      "expected_state": "rejected-or-degraded-with-warning",
