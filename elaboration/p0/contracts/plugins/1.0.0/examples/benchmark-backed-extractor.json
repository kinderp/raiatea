{
  "manifest_version": "1.0.0",
  "plugin": {
    "plugin_id": "org.raiatea.benchmark-extractor",
    "name": "Benchmark-backed PDF Extractor",
    "version": "0.1.0"
  },
  "raiatea_plugin_api": {
    "min_inclusive": "1.0.0",
    "max_exclusive": "2.0.0"
  },
  "families": ["extractor"],
  "capabilities": [
    {
      "capability_id": "extract.run",
      "profiles": [
        {
          "profile_id": "pdf-native-no-ocr",
          "family": "extractor",
          "input_classes": ["B-01-pdf"],
          "output_classes": ["provider-evidence", "processing-run"],
          "contracts": [
            {
              "contract_id": "raiatea.extraction.processing-run",
              "version_range": {
                "min_inclusive": "0.1.0",
                "max_exclusive": "0.2.0"
              },
              "record_kinds": ["ProcessingRunRecord", "ProviderEvidenceRecord"]
            }
          ],
          "backend": "native-pdf",
          "mode": "no-ocr"
        },
        {
          "profile_id": "pdf-rapidocr-torch-en",
          "family": "extractor",
          "input_classes": ["B-01-pdf"],
          "output_classes": ["provider-evidence", "processing-run"],
          "contracts": [
            {
              "contract_id": "raiatea.extraction.processing-run",
              "version_range": {
                "min_inclusive": "0.1.0",
                "max_exclusive": "0.2.0"
              },
              "record_kinds": ["ProcessingRunRecord", "ProviderEvidenceRecord"]
            }
          ],
          "backend": "rapidocr",
          "mode": "torch-en",
          "model_revision": "locked-reference",
          "payload_fingerprint": "sha256:example-model-payload"
        }
      ]
    },
    {
      "capability_id": "extract.probe",
      "profiles": [
        {
          "profile_id": "pdf-probe",
          "family": "extractor",
          "input_classes": ["B-01-pdf"],
          "output_classes": ["processing-run"],
          "contracts": [
            {
              "contract_id": "raiatea.extraction.processing-run",
              "version_range": {
                "min_inclusive": "0.1.0",
                "max_exclusive": "0.2.0"
              },
              "record_kinds": ["ProcessingRunRecord"]
            }
          ]
        }
      ]
    }
  ],
  "permissions": {
    "network": [],
    "filesystem": [],
    "secrets": [],
    "temporary_workspace": true,
    "resource_hints": {
      "cpu_cores": 4,
      "memory_mb": 2048,
      "timeout_seconds": 120
    }
  },
  "entrypoint": {
    "kind": "process",
    "command": ["raiatea-benchmark-extractor"]
  },
  "trust_tier": "official",
  "provenance": {
    "publisher": "Raiatea"
  }
}
