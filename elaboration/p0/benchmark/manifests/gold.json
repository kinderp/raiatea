{
  "contract": {
    "name": "raiatea-p0-benchmark-gold",
    "version": "0.1.0",
    "scope": "benchmark-evidence-only",
    "public_p0_schema": false
  },
  "fixtures": {
    "B01-PDF-001": {
      "assertion_modes": ["exact", "ordered-relation", "tolerance-based"],
      "reference_units": [
        {"id": "title", "type": "heading", "text": "Raiatea B01 PDF 001", "page_index": 0, "region": [72, 700, 360, 735]},
        {"id": "p1", "type": "paragraph", "text": "Alpha paragraph preserves exact benchmark text.", "page_index": 0, "region": [72, 650, 500, 680]},
        {"id": "p2", "type": "paragraph", "text": "Beta paragraph follows alpha in reading order.", "page_index": 0, "region": [72, 610, 500, 640]}
      ],
      "reading_order": [["title", "p1"], ["p1", "p2"]],
      "coordinate_semantics": {"kind": "pdf-page-geometry", "units": "points", "origin": "bottom-left"}
    },
    "B01-PDF-002": {
      "assertion_modes": ["exact", "ordered-relation", "tolerance-based"],
      "reference_units": [
        {"id": "title", "type": "heading", "text": "Raiatea B01 PDF 002", "page_index": 0, "region": [72, 700, 360, 735]},
        {"id": "l1", "type": "paragraph", "text": "Left one.", "page_index": 0, "region": [72, 650, 250, 680]},
        {"id": "l2", "type": "paragraph", "text": "Left two.", "page_index": 0, "region": [72, 610, 250, 640]},
        {"id": "r1", "type": "paragraph", "text": "Right one.", "page_index": 0, "region": [330, 650, 520, 680]},
        {"id": "r2", "type": "paragraph", "text": "Right two.", "page_index": 0, "region": [330, 610, 520, 640]}
      ],
      "reading_order": [["title", "l1"], ["l1", "l2"], ["l2", "r1"], ["r1", "r2"]],
      "coordinate_semantics": {"kind": "pdf-page-geometry", "units": "points", "origin": "bottom-left"}
    },
    "B02-EPUB-001": {
      "assertion_modes": ["exact", "ordered-relation"],
      "spine": ["ch1", "ch2"],
      "reference_units": [
        {"id": "intro", "type": "heading", "text": "Introduction", "resource": "OEBPS/ch1.xhtml", "fragment": "intro"},
        {"id": "intro-p", "type": "paragraph", "text": "The first chapter establishes the package order.", "resource": "OEBPS/ch1.xhtml", "fragment": "intro-text"},
        {"id": "next", "type": "heading", "text": "Next Chapter", "resource": "OEBPS/ch2.xhtml", "fragment": "next"},
        {"id": "next-p", "type": "paragraph", "text": "The second chapter follows the first in the spine.", "resource": "OEBPS/ch2.xhtml", "fragment": "next-text"}
      ],
      "reading_order": [["intro", "intro-p"], ["intro-p", "next"], ["next", "next-p"]],
      "coordinate_semantics": {"kind": "epub-package-logical", "canonical_rendered_pages": false}
    },
    "B02-EPUB-002": {
      "assertion_modes": ["exact", "relation-or-set", "ordered-relation"],
      "spine": ["ch1", "ch2"],
      "navigation": [
        {"label": "Start", "resource": "OEBPS/ch1.xhtml", "fragment": "start"},
        {"label": "Details", "resource": "OEBPS/ch2.xhtml", "fragment": "details"}
      ],
      "links": [
        {"from_resource": "OEBPS/ch1.xhtml", "from_fragment": "to-details", "target": "ch2.xhtml#details"}
